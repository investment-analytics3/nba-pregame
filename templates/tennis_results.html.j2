<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tennis · Results</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="../site.css?v=20261121">
<style>
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:16px;margin:16px 0 22px}
.gc{padding:16px 18px;display:flex;flex-direction:column;gap:4px}
.gc h3{margin:0 0 2px;font-size:19px;letter-spacing:.04em;text-transform:uppercase}
.gc .what{font-size:12px;color:var(--muted);margin-bottom:6px}
.gc .kv{background:none;padding:4px 0;border-top:1px solid var(--line);border-radius:0}
.gc .kv b{color:#fff}
.gc.q{border-color:rgba(47,195,115,.5)}
.filters{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 12px}
.filters select{background:#0E1424;color:#DCE2EE;border:1px solid #2A3550;border-radius:8px;padding:6px 8px;font:inherit;font-size:13px}
.scroll{overflow:auto;max-height:70vh;border-radius:14px;border:1px solid var(--line)}
.scroll table th{position:sticky;top:0;background:#151C2E;z-index:1}
td.l,th.l{text-align:left}
</style>
</head>
<body>
{% macro money(v) %}{{ ('+' if v > 0 else ('-' if v < 0 else '')) ~ '$' ~ ('%.2f' | format(v | abs)) }}{% endmacro %}
{% macro mlf(v) %}{% if v is none %}–{% else %}{{ ('+' if v > 0 else '−') ~ ('{:,}'.format(v | abs)) }}{% endif %}{% endmacro %}
{% macro kvs(s) %}
  <div class="kv"><span>Record</span><b>{{ s.won }}-{{ s.lost }}{% if s.open %} <span class="muted" style="font-weight:500">+{{ s.open }} open</span>{% endif %}</b></div>
  <div class="kv"><span>Won vs priced</span><b>{% if s.n %}{{ s.win }}% vs {{ s.implied }}%{% else %}—{% endif %}</b></div>
  <div class="kv"><span>Edge</span><b class="{{ 'okc' if (s.edge or 0) > 0 else ('noc' if (s.edge or 0) < 0 else '') }}">{% if s.edge is not none %}{{ '%+.1f' | format(s.edge) }} pts{% else %}—{% endif %}</b></div>
  <div class="kv"><span>Avg price</span><b>{{ mlf(s.avg_ml) }}</b></div>
  <div class="kv"><span>Per $100 risked</span><b class="{{ 'okc' if s.pnl > 0 else ('noc' if s.pnl < 0 else '') }}">{{ money(s.pnl) }}{% if s.roi is not none %} <span class="muted" style="font-weight:500">({{ '%+.1f' | format(s.roi) }}%)</span>{% endif %}</b></div>
{% endmacro %}
{% macro table(rows, first) %}
  <div class="tw"><table><tr><th class="l">{{ first }}</th><th>Record</th><th>Won %</th><th>Priced %</th><th>Edge</th><th>Avg price</th><th>P&amp;L / $100</th><th>Open</th></tr>
  {% for r in rows %}<tr><td class="l">{{ r.label }}</td><td>{{ r.won }}-{{ r.lost }}</td><td>{{ r.win if r.win is not none else '—' }}</td><td>{{ r.implied if r.implied is not none else '—' }}</td>
    <td class="{{ 'okc' if (r.edge or 0) > 0 else ('noc' if (r.edge or 0) < 0 else '') }}">{{ ('%+.1f' | format(r.edge)) if r.edge is not none else '—' }}</td><td>{{ mlf(r.avg_ml) }}</td>
    <td class="{{ 'okc' if r.pnl > 0 else ('noc' if r.pnl < 0 else '') }}">{{ money(r.pnl) }}</td><td>{{ r.open }}</td></tr>{% endfor %}
  </table></div>
{% endmacro %}
<div class="wrap">
  <div class="nav"><a href="{{ pages_url }}">Home</a><a href="./">Tennis board</a><a class="on" href="results.html">Results</a></div>
  <div class="eyebrow" style="margin-top:18px">Tennis · Kalshi favorites -800 or shorter · tracking only</div>
  <h1 class="title cond">Tennis results</h1>
  <div class="small muted" style="margin-top:6px">Updated {{ built }} · <a href="results.csv">Download CSV</a> · each match graded from Kalshi's result at the price logged 5-8 h (ITF 10-13 h) before Kalshi's listed time; voids (walkovers, or a price taken mid-match) left out</div>

  {% for tab, label in tabs.items() %}{% set B = b[tab] %}
  <div class="sec-head" style="margin-top:26px"><h2 class="cond">{{ label }}</h2><span class="cnt">{{ B.all.tracked }}</span><span class="rule"></span><span class="small muted">{{ 'Hero 0-20' if tab == 'main' else 'Hero 0-10' }}</span></div>
  <div class="cards">
    <div class="panel gc q"><h3 class="cond">Qualified</h3><div class="what">-1000 to -2000, Elo top 25 vs 51+</div>{{ kvs(B.qualified) }}</div>
    {% for t in B.tiers %}<div class="panel gc"><h3 class="cond">{{ t.label }}</h3><div class="what">every match in this price range</div>{{ kvs(t) }}</div>{% endfor %}
  </div>
  <div class="panel" style="padding:14px 18px;margin-bottom:16px"><h3 style="margin:0 0 8px">By hero score</h3>{{ table(B.bands, 'Score') }}</div>
  <div class="panel" style="padding:14px 18px;margin-bottom:16px"><h3 style="margin:0 0 8px">By tour</h3>{{ table(B.tours, 'Tour') }}</div>
  {% endfor %}

  <div class="sec-head" style="margin-top:26px"><h2 class="cond">Every tracked match</h2><span class="cnt" id="cnt">{{ rows | length }}</span><span class="rule"></span></div>
  <div class="filters">
    <select id="ft"><option value="">Both tabs</option>{% for k, l in tabs.items() %}<option value="{{ k }}">{{ l }}</option>{% endfor %}</select>
    <select id="fp"><option value="">Any price</option><option value="t800">-800 to -1000</option><option value="t1000">-1000 to -2000</option><option value="t2000">Shorter than -2000</option></select>
    <select id="fq"><option value="">Any section</option><option value="qualified">Qualified</option><option value="watch">Watch list</option><option value="short">Shorter than -2000</option></select>
    <select id="fb"><option value="">Any score</option>{% for x in ['15-20','10-14','0-9','8-10','5-7','0-4'] %}<option>{{ x }}</option>{% endfor %}</select>
    <select id="fs"><option value="">Any result</option><option value="won">Won</option><option value="lost">Lost</option><option value="open">Open</option><option value="void">Void</option></select>
  </div>
  <div class="scroll"><table id="led">
    <tr><th class="l">Start (PT)</th><th class="l">Favorite</th><th class="l">Opponent</th><th class="l">Event</th><th>Price</th><th>Score</th><th>Elo</th><th>Section</th><th>Result</th><th>P&amp;L / $100</th></tr>
    {% for r in rows %}
    <tr data-t="{{ r.tab }}" data-p="{{ r.tier }}" data-q="{{ r.section }}" data-b="{{ r.hero_band }}" data-s="{{ r.status }}">
      <td class="l">{{ r.start_pt }}</td><td class="l">{{ r.fav.name }}</td><td class="l muted">{{ r.opp.name }}</td><td class="l muted">{{ r.tour }} · {{ r.tourney }}{% if r.round %} · {{ r.round }}{% endif %}</td>
      <td>{{ mlf(r.ml) }}{% if r.late %} <span class="muted">late</span>{% endif %}</td><td>{{ r.score }}/{{ r.max }}</td>
      <td>{{ ('#' ~ r.fav.elo_rank) if r.fav.elo_rank else 'NR' }} v {{ ('#' ~ r.opp.elo_rank) if r.opp.elo_rank else 'NR' }}</td>
      <td>{{ {'qualified': 'Qualified', 'watch': 'Watch', 'short': '-2000+'}[r.section] }}</td>
      <td>{% if r.status == 'won' %}<span class="chip cg">Won</span>{% elif r.status == 'lost' %}<span class="chip cr">Lost</span>{% elif r.status == 'void' %}<span class="chip cn" title="{{ r.void_reason or '' }}">Void</span>{% else %}<span class="chip cn">Open</span>{% endif %}</td>
      <td class="{{ 'okc' if (r.pnl or 0) > 0 else ('noc' if (r.pnl or 0) < 0 else '') }}">{{ money(r.pnl) if r.pnl is not none else '—' }}</td></tr>
    {% endfor %}
  </table></div>
  <div class="tiny">Tracking only: the board reads Kalshi's public prices and never places a bet. P&amp;L assumes $100 risked on the favorite at the logged price, Kalshi taker fee included.</div>
</div>
<script>
(function(){
  const f = ['ft','fp','fq','fb','fs'].map(id => document.getElementById(id)), keys = ['t','p','q','b','s'];
  const rows = [...document.querySelectorAll('#led tr[data-t]')], cnt = document.getElementById('cnt');
  function apply(){ let n = 0; rows.forEach(r => { const ok = f.every((el,i) => !el.value || r.dataset[keys[i]] === el.value); r.style.display = ok ? '' : 'none'; if (ok) n++; }); cnt.textContent = n; }
  f.forEach(el => el.addEventListener('change', apply)); apply();
})();
</script>
</body>
</html>
