<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Weather · Kalshi paper board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="../site.css?v=20261121">
<style>
.top{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px;margin:20px 0 28px}
.top .panel{padding:18px 20px;display:flex;flex-direction:column;gap:10px}
.top h3{margin:0;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:#C7CEDC}
.bet td.br{font-weight:600}.bet td{font-size:13px}
.nchk{display:flex;flex-wrap:wrap;gap:6px}
.note{font-size:13px;line-height:1.6;color:#C7CEDC}
.note b{color:#fff}
.dayh{display:flex;align-items:baseline;gap:10px;margin:0 0 10px}
.dayh h3{margin:0;font-size:22px}.dayh span{font-size:12.5px;color:var(--muted)}
.gtab td:first-child{font-weight:600}
</style>
</head>
<body>
<div class="wrap">
  <div class="nav"><a class="on" href="./">Weather board</a><a href="results.html">Results</a><a href="../">All boards</a></div>
  <div class="eyebrow" style="margin-top:18px">Kalshi daily temperature · paper trading · never places bets</div>
  <h1 class="title cond">Weather</h1>
  <div class="small muted" style="margin-top:6px">Updated {{ built }}</div>

  <div class="top">
    {% set nb = by_date | selectattr("label", "equalto", tomorrow) | list %}
    <div class="panel">
      <h3>Tomorrow · {{ tomorrow }}</h3>
      {% if nb %}{% set t = nb[0] %}
      <div class="stat"><div><b>{{ t.bets | length }}</b><span>paper bets</span></div><div><b>${{ "%.0f" | format(t.cost) }}</b><span>at risk</span></div><div><b>${{ "%.2f" | format(t.max_win) }}</b><span>max win</span></div></div>
      <div class="small muted">{{ t.cities }} of 7 cities had a bracket priced 1-4c.</div>
      {% else %}
      <div class="big" style="font-size:17px;font-weight:600">No bets logged yet</div>
      <div class="small muted">Each city is checked about 32 hours before its market closes (around 5 PM local, the day before).</div>
      {% endif %}
    </div>
    <div class="panel">
      <h3>Main rule so far</h3>
      {% set s = main.stats %}
      <div class="stat"><div><b>{{ s.won }}-{{ s.lost }}</b><span>record</span></div><div><b class="{{ 'okc' if s.pnl > 0 else ('noc' if s.pnl < 0 else '') }}">{{ s.pnl | money }}</b><span>paper P&amp;L</span></div><div><b>{{ s.open }}</b><span>open</span></div></div>
      <div class="small muted">{% if s.settled %}{{ "%+.2f" | format(s.cpc) }}c per contract · won {{ s.win }}% at an average NO price of {{ s.price }}c{% else %}Nothing settled yet. Backtest: {{ main.bt.cpc }}c per contract, {{ main.bt.losses }} losses in {{ main.bt.trades }}.{% endif %}</div>
    </div>
    <div class="panel">
      <h3>Next checks (Pacific)</h3>
      <div class="nchk">{% for c in checks %}<span class="chip cn">{{ c.city }} · {{ c.when }}</span>{% else %}<span class="small muted">All set for now.</span>{% endfor %}</div>
      <div class="small muted">One phone summary a day around 5:20 PM PT.</div>
    </div>
  </div>

  <div class="sec-head"><h2 class="cond">Open paper bets · main rule</h2><span class="cnt">{{ by_date | map(attribute="bets") | map("length") | sum }}</span><span class="rule"></span></div>
  {% for d in by_date %}
  <div class="panel" style="padding:16px 18px;margin-bottom:18px">
    <div class="dayh"><h3 class="cond">{{ d.label }}</h3><span>{{ d.bets | length }} bets · {{ d.cities }} cities · ${{ "%.2f" | format(d.cost) }} at risk · up to ${{ "%.2f" | format(d.max_win) }}</span></div>
    <div class="tw"><table class="bet">
      <tr><th>City</th><th>Bracket (we buy NO)</th><th>YES bid</th><th>NO price</th><th>Contracts</th><th>Cost</th><th>Max win</th><th>Forecast high</th><th>Status</th></tr>
      {% for b in d.bets %}
      <tr><td>{{ b.city }}</td><td class="br" style="text-align:left">{{ b.bracket }}</td><td>{{ "%.0f" | format(b.yes_bid * 100) }}c</td><td>{{ "%.0f" | format(b.no_price * 100) }}c</td>
        <td>{{ b.contracts }}{% if b.contracts < cfg.CONTRACTS %} <span class="muted">(book)</span>{% endif %}</td><td>${{ "%.2f" | format(b.cost) }}</td><td>${{ "%.2f" | format(b.max_win) }}</td>
        <td>{{ ("%.0f°" | format(b.forecast)) if b.forecast is not none else "—" }}</td>
        <td>{% if b.status == "won" %}<span class="chip cg">Won {{ b.pnl | money }}</span>{% elif b.status == "lost" %}<span class="chip cr">Lost {{ b.pnl | money }}</span>{% else %}<span class="chip cn">Open</span>{% endif %}</td></tr>
      {% endfor %}
    </table></div>
  </div>
  {% else %}
  <div class="panel" style="padding:16px 18px;margin-bottom:18px"><div class="small muted">No open bets. The next checks are listed above.</div></div>
  {% endfor %}

  <div class="sec-head"><h2 class="cond">Comparison groups</h2><span class="cnt">paper only</span><span class="rule"></span></div>
  <div class="panel" style="padding:14px 18px;margin-bottom:24px"><div class="tw"><table class="gtab">
    <tr><th>Group</th><th style="text-align:left">What</th><th>Open</th><th>Settled</th><th>Record</th><th>Paper P&amp;L</th><th>c/contract</th><th>Backtest c/contract</th></tr>
    {% for g in groups %}{% set s = g.stats %}
    <tr><td>{{ g.label }}</td><td style="text-align:left" class="muted">{{ g.note }}</td><td>{{ s.open }}</td><td>{{ s.settled }}</td><td>{{ s.won }}-{{ s.lost }}</td>
      <td class="{{ 'okc' if s.pnl > 0 else ('noc' if s.pnl < 0 else '') }}">{{ s.pnl | money }}</td><td>{{ ("%+.2f" | format(s.cpc)) if s.cpc is not none else "—" }}</td><td class="muted">{{ "%+.2f" | format(g.bt.cpc) }}</td></tr>
    {% endfor %}
  </table></div></div>

  <div class="panel final" style="padding:16px 20px">
    <div class="note">
      <b>The rule.</b> About 32 hours before a city's daily-high market closes (around 5 PM local the day before), buy NO on every bracket whose best YES bid is 1-4c, {{ cfg.CONTRACTS }} contracts at the best price (fewer if the book is thinner). Each win pays 1-4c a contract; each loss costs 96-99c.<br>
      <b>Why.</b> Two public studies found weather forecasts don't beat these markets, but long-shot brackets settle YES less often than their price. Our check on Oct 6 - Nov 25 data: {{ main.bt.trades }} bets, {{ main.bt.losses }} losses, {{ "%+.2f" | format(main.bt.cpc) }}c per contract (90% range {{ main.bt.ci }}) in the 7 original cities only.<br>
      <b>Settlement.</b> Kalshi settles on the NWS climate report, usually the next morning; the board marks each bet from Kalshi's official result.<br>
      <b>Decision point.</b> Review after ~300-400 main-rule bets. Forecast highs are Open-Meteo, shown for context only.
    </div>
  </div>
</div>
</body>
</html>
