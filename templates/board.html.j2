<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NBA Pregame Board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap">
<style>
:root{--bg:#0A0F1C;--card1:#172036;--card2:#111829;--line:#1F2A42;--text:#E6EAF2;--muted:#8B95AB;--dim:#7C869E;
--green:#2FC373;--yellow:#E9B23A;--red:#C83030;--amber:#FB923C;--blue:#60A5FA;--orange:#FB923C}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}
a{color:#93C5FD}
.wrap{max-width:1120px;margin:0 auto;padding:24px 16px 72px}
.cond{font-family:'Barlow Condensed',Inter,sans-serif}
.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:600}
h1.title{margin:6px 0 0;font-size:44px;line-height:1;font-weight:700}
.chip{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}
.legend{display:flex;flex-wrap:wrap;gap:8px 18px;margin:16px 0 28px;font-size:12.5px;color:#9AA4BA}
.legend span{display:inline-flex;align-items:center;gap:6px}.sw{width:10px;height:10px;border-radius:3px;display:inline-block}
.panel{border-radius:18px;border:1px solid var(--line);background:linear-gradient(180deg,var(--card1),var(--card2));box-shadow:0 12px 30px rgba(0,0,0,.4)}
.final{padding:16px 18px;margin-bottom:26px;border-color:rgba(96,165,250,.45)}
.final h2{margin:0 0 8px;font-size:15px}.final ul{margin:0;padding-left:18px;color:#D3D9E5;font-size:14px;line-height:1.6}
.sec-head{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.sec-head h2{margin:0;font-size:24px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.sec-head .cnt{font-size:12px;font-weight:700;color:#C7CEDC;background:#1A2236;border:1px solid #26314B;padding:2px 9px;border-radius:999px}
.sec-head .rule{flex:1;height:1px;background:linear-gradient(90deg,#2A3653,rgba(42,54,83,0))}
.amberline{height:4px;margin:-4px 0 20px;border-radius:999px;background:linear-gradient(90deg,#FADB80,#D9A12A 70%,#8A5F0E);box-shadow:0 0 12px rgba(233,178,58,.45)}
.redline{height:6px;margin:-4px 0 20px;border-radius:999px;background:linear-gradient(90deg,#F05252,#C42B2B 70%,#8E1A1A);box-shadow:0 0 16px rgba(240,82,82,.55)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,360px),1fr));gap:20px;margin-bottom:34px}
.card{all:unset;box-sizing:border-box;display:flex;flex-direction:column;gap:14px;padding:18px 18px 14px;cursor:pointer;
border-radius:18px;border:1px solid var(--line);background:linear-gradient(180deg,var(--card1),var(--card2));
box-shadow:0 12px 30px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.05);transition:transform .18s,box-shadow .18s,border-color .18s}
.card:hover{transform:translateY(-3px);border-color:#34415F}.card:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.row{display:flex;align-items:center;gap:10px}.between{justify-content:space-between}
.tip{font-size:12px;font-weight:700;letter-spacing:.1em;color:#A9B2C6;text-transform:uppercase}
.b2b{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--muted)}
.yn{padding:1px 6px;border-radius:5px;font-size:11px;font-weight:700}
.badge{flex:none;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-weight:700;font-size:15px;color:#F3F6FB;
box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 3px 8px rgba(0,0,0,.35)}
.tag{font-size:9.5px;font-weight:800;letter-spacing:.08em;padding:1px 6px;border-radius:5px}
.sub{font-size:12.5px;color:var(--muted);margin-top:3px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.line{font-size:19px;font-weight:600}
.qual{display:flex;gap:7px;font-size:12.5px;line-height:1.4}
.warn{font-size:12px;line-height:1.4;color:#FDE68A;background:rgba(233,178,58,.12);border:1px solid rgba(233,178,58,.4);border-radius:10px;padding:6px 10px}
.pills{display:flex;flex-direction:column;gap:6px;padding:12px 10px 10px;border-radius:14px;background:rgba(6,10,20,.45);box-shadow:inset 0 1px 3px rgba(0,0,0,.5)}
.prow{display:grid;grid-template-columns:56px repeat(4,minmax(0,1fr));gap:6px;align-items:center}
.ph{display:flex;flex-direction:column;align-items:center;line-height:1.15}.ph b{font-size:10.5px;color:#C7CEDC}.ph span{font-size:9.5px;color:var(--dim)}
.pl{display:flex;flex-direction:column;line-height:1.1}.pl b{font-size:12px;color:#DCE2EE}.pl span{font-size:10px;color:var(--dim)}
.pill{display:flex;align-items:center;justify-content:center;white-space:nowrap;height:30px;border-radius:9px;font-weight:700;font-size:16px;animation:pop .45s cubic-bezier(.34,1.56,.64,1) both}
.pg{background:linear-gradient(180deg,#34C77B,#1A8A4C);color:#fff;text-shadow:0 1px 1px rgba(0,0,0,.25);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 -2px 0 rgba(0,0,0,.2),0 3px 8px rgba(20,140,75,.35)}
.py{background:linear-gradient(180deg,#FADB80,#D9A12A);color:#2A1C00;box-shadow:inset 0 1px 0 rgba(255,255,255,.45),inset 0 -2px 0 rgba(0,0,0,.18),0 3px 8px rgba(200,150,30,.3)}
.pr{background:linear-gradient(180deg,#D44444,#A12222);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.25),inset 0 -2px 0 rgba(0,0,0,.25),0 3px 8px rgba(190,40,40,.35)}
.pd{background:linear-gradient(180deg,#A31818,#650909);color:#fff;animation:pop .45s cubic-bezier(.34,1.56,.64,1) both,pulse 2.4s ease-in-out infinite}
.pn{background:#1C2438;color:var(--dim)}
.more{display:flex;justify-content:flex-end;align-items:center;gap:4px;font-size:12px;font-weight:600;color:#8FB8F5}
.donut{position:relative;flex:none}.donut svg{width:100%;height:100%;overflow:visible}
.donut .num{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.donut .num b{font-weight:700;line-height:.9;text-shadow:0 2px 8px rgba(0,0,0,.5)}.donut .num span{font-size:10px;font-weight:600;letter-spacing:.08em;color:var(--dim)}
.arc{animation:sweep 1.2s cubic-bezier(.33,1,.68,1) both}
.card-in{animation:cardIn .6s cubic-bezier(.22,1,.36,1) both}
.grow{transform-origin:left center;animation:grow .9s cubic-bezier(.33,1,.68,1) both}
.grow-r{transform-origin:right center;animation:grow .9s cubic-bezier(.33,1,.68,1) both}
.draw{animation:draw 1.1s cubic-bezier(.33,1,.68,1) both}.fade{animation:fade .5s ease both}
@keyframes cardIn{from{opacity:0;transform:translateY(16px)}}
@keyframes pop{from{opacity:0;transform:scale(.55)}}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,70,70,0)}50%{box-shadow:0 0 0 4px rgba(255,70,70,.28),0 0 16px rgba(255,60,60,.6)}}
@keyframes sweep{from{stroke-dashoffset:289.027}}
@keyframes grow{from{transform:scaleX(0)}}
@keyframes draw{from{stroke-dashoffset:1}}
@keyframes fade{from{opacity:0}}
@media (max-width:420px){.card .donut{width:88px!important;height:88px!important}.card .donut .num b{font-size:30px!important}h1.title{font-size:36px}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
/* detail */
.btn{all:unset;display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid #26314B;background:#151C2E;color:#DCE2EE;font-size:14px;font-weight:600;cursor:pointer}
.banner{display:flex;gap:12px;align-items:flex-start;padding:14px 18px;margin-bottom:16px;border-radius:14px}
.two{display:flex;flex-wrap:wrap;gap:20px;margin-bottom:20px}
.pad{padding:22px}
h3{margin:0 0 4px;font-size:16px;font-weight:700}
.note{margin:0 0 14px;font-size:12.5px;color:var(--muted)}
.hm{display:grid;grid-template-columns:76px repeat(4,minmax(0,1fr));gap:6px;align-items:center;margin-bottom:6px}
.hm .cell{display:flex;flex-direction:column;align-items:center;justify-content:center;height:48px;border-radius:10px;animation:pop .45s cubic-bezier(.34,1.56,.64,1) both}
.cols2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:20px;margin-bottom:20px}
.cols3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px}
.cols4{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:16px;margin-bottom:20px}
.tbl-row{display:grid;grid-template-columns:88px minmax(0,1fr) auto;gap:8px;align-items:center;padding:9px 0;border-top:1px solid var(--line);font-size:13.5px}
.wl{width:22px;height:22px;border-radius:6px;display:grid;place-items:center;font-size:11px;font-weight:800}
.nav{display:flex;gap:6px;border-bottom:1px solid var(--line);padding-bottom:10px}
.nav a{padding:8px 14px;border-radius:999px;font-size:14px;font-weight:600;color:#C7CEDC;text-decoration:none}
.nav a.on{background:#1C2640;color:#fff;border:1px solid #2E3B5C}
.sec-title{margin:6px 0 12px;font-size:22px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
/* live */
.tabs{display:inline-flex;padding:4px;border-radius:999px;background:#121A2C;border:1px solid #26314B;gap:4px}
.tabs a{min-height:36px;display:inline-flex;align-items:center;gap:7px;padding:0 16px;border-radius:999px;font-size:14px;font-weight:600;color:#9AA4BA;text-decoration:none}
.tabs a.on{background:linear-gradient(180deg,#2E4170,#1C2845);color:#fff}
.lv:empty{display:none}
.lv{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;letter-spacing:.04em;padding:3px 9px;border-radius:999px;background:#121A2C;border:1px solid #26314B;color:#DCE2EE;width:fit-content}
.lv .g{padding:0 6px;border-radius:5px;font-size:11px;background:linear-gradient(180deg,#34C77B,#1A8A4C);color:#fff;text-shadow:0 1px 1px rgba(0,0,0,.25)}.lv .g.B{background:#FADB80;color:#2A1C00}.lv .g.C{background:#D44444;color:#fff}
.lv-dot:not(:empty),.lv i{width:7px;height:7px;border-radius:50%;background:#F05252;box-shadow:0 0 6px #F05252;display:inline-block;animation:blink 1.6s ease-in-out infinite}
@keyframes blink{50%{opacity:.35}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<radialGradient id="ringgreen" cx="60" cy="60" r="53" gradientUnits="userSpaceOnUse"><stop offset=".74" stop-color="#0F7A3F"/><stop offset=".83" stop-color="#6BF0AA"/><stop offset=".92" stop-color="#2BBE6E"/><stop offset="1" stop-color="#0C5C31"/></radialGradient>
<radialGradient id="ringyellow" cx="60" cy="60" r="53" gradientUnits="userSpaceOnUse"><stop offset=".74" stop-color="#9A6E0E"/><stop offset=".83" stop-color="#FFE596"/><stop offset=".92" stop-color="#EDB53A"/><stop offset="1" stop-color="#7F5A09"/></radialGradient>
<radialGradient id="ringred" cx="60" cy="60" r="53" gradientUnits="userSpaceOnUse"><stop offset=".74" stop-color="#861818"/><stop offset=".83" stop-color="#FF8A8A"/><stop offset=".92" stop-color="#DD3E3E"/><stop offset="1" stop-color="#6E1010"/></radialGradient>
<radialGradient id="ringtrack" cx="60" cy="60" r="53" gradientUnits="userSpaceOnUse"><stop offset=".74" stop-color="#1A2236"/><stop offset=".83" stop-color="#3A4562"/><stop offset=".92" stop-color="#2B3550"/><stop offset="1" stop-color="#161D2E"/></radialGradient>
<radialGradient id="hub" cx="50%" cy="35%" r="70%"><stop offset="0" stop-color="#222C45"/><stop offset="1" stop-color="#0D1322"/></radialGradient>
<filter id="drop" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#000" flood-opacity=".6"/></filter>
</defs></svg>
<div class="wrap" style="padding-bottom:0"><nav class="nav"><a href="{{ pages_url }}">Home</a><a class="on" href="{{ pages_url }}nba/">Today's board</a><a href="{{ pages_url }}results.html">Results</a><a href="{{ pages_url }}live/">Live</a></nav></div>
<div class="wrap" id="app" style="padding-top:18px"></div>
<script>const DATA = {{ data_json|safe }};</script>
<script src="{{ pages_url }}live/engine.js" defer></script>
<script>
(function(){
const C = 289.027, MAX = DATA.max || 40;
const NAMES = {efg:'eFG%', off:'Off Eff', opp_efg:'Opp eFG%', def:'Def Eff'};
const COLS = [{f:'efg',d:'opp_efg',top:'eFG%',sub:'vs D eFG',fly:'Shooting'},{f:'off',d:'def',top:'OFF',sub:'vs DEF',fly:'Scoring'},
              {f:'opp_efg',d:'efg',top:'D eFG',sub:'vs eFG',fly:'Shot defense'},{f:'def',d:'off',top:'DEF',sub:'vs OFF',fly:'Stops'}];
const BAND = {green:{num:'#5BEA9E',word:'Strong edge'},yellow:{num:'#FFD66B',word:'Moderate'},red:{num:'#FF7676',word:'Risk'}};
const PILL = {green:'pg',yellow:'py',red:'pr','deep-red':'pd',none:'pn'};
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = (m,v) => v==null ? '–' : (m==='efg'||m==='opp_efg' ? v.toFixed(1)+'%' : v.toFixed(1));
const favOf = g => g.favorite==='home' ? g.home : (g.favorite==='away' ? g.away : null);
const dogOf = g => g.favorite==='home' ? g.away : (g.favorite==='away' ? g.home : null);
const rk = (t,w,m) => (((t||{})[w]||{}).ranks||{})[m];
const favCls = r => r==null?'pn':(r<=10?'pg':(r<=20?'py':'pr'));
const dogCls = r => r==null?'pn':(r<=5?'pd':(r<=10?'pr':(r<=20?'py':'pg')));
const app = document.getElementById('app');

function donut(sc, size, delay){
  if(!sc || !sc.scored) return `<div class="donut" style="width:${size}px;height:${size}px"><svg viewBox="0 0 120 120" aria-hidden="true">
    <circle cx="60" cy="60" r="46" fill="none" stroke="url(#ringtrack)" stroke-width="13"/><circle cx="60" cy="60" r="38" fill="url(#hub)"/></svg>
    <div class="num"><b class="cond" style="font-size:${size*.3}px;color:#8B95AB">–</b><span>NO LINE</span></div></div>`;
  const b = BAND[sc.band], off = (C*(1-sc.score/MAX)).toFixed(2);
  return `<div class="donut" style="width:${size}px;height:${size}px"><svg viewBox="0 0 120 120" role="img" aria-label="Hero score ${sc.score} of ${MAX}, ${b.word}">
    <circle cx="60" cy="60" r="46" fill="none" stroke="#070B15" stroke-width="16"/>
    <circle cx="60" cy="60" r="46" fill="none" stroke="url(#ringtrack)" stroke-width="13"/>
    <circle cx="60" cy="60" r="38" fill="url(#hub)" stroke="rgba(255,255,255,.05)"/>
    <g transform="rotate(-90 60 60)"><circle class="arc" cx="60" cy="60" r="46" fill="none" stroke="url(#ring${sc.band})" stroke-width="13" stroke-linecap="round"
      style="stroke-dasharray:${C};stroke-dashoffset:${off};filter:url(#drop);animation-delay:${delay}ms"/></g></svg>
    <div class="num"><b class="cond" data-count="${sc.score}" data-delay="${delay}" style="font-size:${size*.33}px;color:${b.num}">${sc.score}</b><span>/ ${MAX}</span></div></div>`;
}

// Power rank and last-3 pills (Nov 10). Favorite: top 10 / 3-0 green, 11-20 / 2-1 yellow,
// bottom 10 / 1-2, 0-3 red. Underdog: the same, flipped (strong underdog = red).
const FORM = {g:'color:#fff;background:linear-gradient(180deg,#34C77B,#1A8A4C);text-shadow:0 1px 1px rgba(0,0,0,.25)',
              y:'color:#2A1C00;background:linear-gradient(180deg,#FADB80,#D9A12A)',
              r:'color:#fff;background:linear-gradient(180deg,#D44444,#A12222)'};
const flip = c => c==='g' ? 'r' : (c==='r' ? 'g' : c);
function prPill(rank, isFav){
  if(rank==null) return '#–';
  const c = rank<=10 ? 'g' : (rank<=20 ? 'y' : 'r');
  return `<span class="yn" style="${FORM[isFav?c:flip(c)]}">#${rank}</span>`;
}
function formPill(rec, isFav){
  if(!rec) return '–';
  const c = rec==='3-0' ? 'g' : (rec==='2-1' ? 'y' : 'r');
  return `<span class="yn" style="${FORM[isFav?c:flip(c)]}">${esc(rec)}</span>`;
}

function teamLine(g, t){
  const isFav = t.is_fav, p = t.power||{};
  return `<div class="row">
    <span class="badge cond" style="font-size:${t.abbr.length>3?12:15}px;background:${isFav?'linear-gradient(180deg,#2E4170,#1C2845)':'linear-gradient(180deg,#252E45,#181F31)'}">${esc(t.abbr)}</span>
    <div style="min-width:0;flex:1"><div class="row" style="gap:6px;flex-wrap:wrap"><span style="font-weight:600;font-size:15px">${t===g.home?'<span style="color:#7C869E">@ </span>':''}${esc(t.name)}</span>
      ${isFav?'<span class="tag" style="color:#BFDBFE;background:rgba(96,165,250,.16);border:1px solid rgba(96,165,250,.4)">FAV</span>':''}</div>
      <div class="sub"><span>${esc(t.record||'')} · L3 ${formPill(t.l3_record, isFav)} · PR ${prPill(p.rank, isFav)}</span>
      ${p.split?'<span class="tag" style="color:#FDBA74;background:rgba(251,146,60,.14);border:1px solid rgba(251,146,60,.45)">SPLIT</span>':''}
      ${isFav && rk(t,'season','net')!=null && rk(t,'season','net')<=10?`<span class="tag" style="color:#fff;background:rgba(47,195,115,.14);border:1px solid rgba(47,195,115,.4)">NET #${rk(t,'season','net')}</span>`:''}</div></div>
    <span class="line cond" style="color:${isFav?'#F3F6FB':'#8B95AB'}">${esc(t.spread_text||'')}</span></div>`;
}

function pillGrid(sc, base){
  if(!sc || !sc.pills) return '';
  let h = `<div class="pills"><div class="prow" style="align-items:end"><span></span>${COLS.map(c=>`<span class="ph"><b>${c.top}</b><span>${c.sub}</span></span>`).join('')}</div>`;
  sc.pills.forEach((r,ri)=>{
    h += `<div class="prow" style="margin-top:${ri===2?8:0}px"><span class="pl"><b>${esc(r.team)}</b><span>${r.window==='season'?'Season':'Last 3'}</span></span>` +
      r.cells.map((c,ci)=>`<span class="pill cond ${PILL[c.color]}" title="${esc(r.team)} ${r.window==='season'?'season':'last 3'} ${NAMES[c.metric]}: rank ${c.rank??'n/a'}" style="animation-delay:${base+ri*90+ci*45}ms"><span>#${c.rank??'–'}</span></span>`).join('') + '</div>';
  });
  return h + '</div>';
}

function card(g, i){
  const sc = g.scoring||{}, delay = i*110, fav = favOf(g);
  const keyOut = [g.away,g.home].reduce((n,t)=>n+(t.key_out||[]).length,0);
  const tier = sc.tier || (sc.qualified ? 'qualified' : 'out');
  const qline = !sc.scored ? ['#9AA4BA','M4 8h8','No spread posted yet']
    : (tier==='qualified' ? ['#86EFAC','M3 8.5l3.2 3L13 4.5','Qualified: '+(sc.route||sc.qualifiers.join(' · '))]
    : (tier==='watch' ? ['#FCD97A','M8 3v6M8 12v.5',sc.fails[0]] : ['#FCA5A5','M4 4l8 8M12 4l-8 8',sc.fails[0]]));
  const yellows = (sc.warnings||[]).filter(w=>/questionable/i.test(w));
  const b2b = [g.away,g.home].map(t=>`<span>${esc(t.abbr)} <span class="yn" style="${t.b2b?'color:#fff;background:linear-gradient(180deg,#D44444,#A12222)':'color:#fff;background:linear-gradient(180deg,#34C77B,#1A8A4C);text-shadow:0 1px 1px rgba(0,0,0,.25)'}">${t.b2b?'Yes':'No'}</span></span>`).join('');
  return `<button type="button" class="card card-in" style="animation-delay:${delay}ms" onclick="openGame('${g.id}')" aria-label="${esc(g.away.name)} at ${esc(g.home.name)}, open full breakdown">
    <div class="row between" style="align-items:flex-start"><div style="display:flex;flex-direction:column;gap:5px"><span class="tip">${esc(g.tip_pt)}${g.neutral?' · Neutral':''}</span>
      ${sc.tracked?`<span class="lv" data-live="${g.id}"></span>`:''}
      <span class="b2b"><b style="letter-spacing:.08em">B2B</b>${b2b}</span></div>
      <div class="row" style="gap:6px">${keyOut?`<span class="chip" style="color:#FCA5A5;background:rgba(220,50,50,.14);border:1px solid rgba(220,50,50,.4)">+ ${keyOut} key out</span>`:''}
      ${sc.scored && tier==='out'?'<span class="chip" style="color:#fff;background:linear-gradient(180deg,#D44444,#A12222);letter-spacing:.08em;text-transform:uppercase">No track</span>':''}
      ${sc.scored && tier==='watch'?'<span class="chip" style="color:#2A1C00;background:linear-gradient(180deg,#FADB80,#D9A12A);letter-spacing:.08em;text-transform:uppercase">Watch list</span>':''}</div></div>
    <div class="row" style="gap:14px"><div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:12px">${teamLine(g,g.away)}${teamLine(g,g.home)}</div>${donut(sc,108,delay)}</div>
    <div class="qual" style="color:${qline[0]}"><svg viewBox="0 0 16 16" width="14" height="14" style="flex:none;margin-top:2px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round" aria-hidden="true"><path d="${qline[1]}"/></svg><span>${esc(qline[2])}</span></div>
    ${yellows.map(w=>`<div class="warn">${esc(w)}</div>`).join('')}
    ${pillGrid(sc, 380+delay)}
    <div class="more">Full breakdown <svg viewBox="0 0 16 16" width="13" height="13" style="fill:none;stroke:currentColor;stroke-width:2" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></div></button>`;
}

function listView(){
  const tierOf = g => (g.scoring && (g.scoring.tier || (g.scoring.qualified ? 'qualified' : 'out'))) || 'out';
  const q = DATA.games.filter(g=>tierOf(g)==='qualified'), w = DATA.games.filter(g=>tierOf(g)==='watch'), n = DATA.games.filter(g=>tierOf(g)==='out');
  const kindLabel = DATA.kind==='final' ? 'Final' : (DATA.kind==='preview' ? 'Preview' : (DATA.kind==='retro' ? 'Rebuilt board' : 'Pregame board'));
  let h = `<header class="row between" style="flex-wrap:wrap;align-items:flex-end;gap:16px"><div><div class="eyebrow">NBA · ${kindLabel}</div><h1 class="title cond">${esc(DATA.date_label)}</h1></div>
    <div style="text-align:right;font-size:13px;color:var(--muted);line-height:1.6">Data pulled ${esc(DATA.built_label)} · ${DATA.games.length} games<br>Stats through ${esc(DATA.metrics_through_label||'–')}</div></header>
    <div class="legend"><span><i class="sw" style="background:var(--green)"></i>Edge for the favorite</span><span><i class="sw" style="background:var(--yellow)"></i>Middle of the league / warning</span>
    <span><i class="sw" style="background:var(--red)"></i>Risk or threat</span><span><i class="sw" style="background:#7A0E0E;box-shadow:0 0 8px rgba(255,60,60,.8)"></i>Underdog top 5 (pulses)</span>
    <span><i class="sw" style="background:var(--amber)"></i>Power-rank split that matters</span></div>`;
  if(DATA.kind==='retro'){
    h += `<div class="panel final" style="border-color:rgba(233,178,58,.5)"><h2>Rebuilt after the fact</h2><div style="color:#D3D9E5;font-size:14px;line-height:1.6">This board was not sent at the time. It was rebuilt using only what was known before tip-off: stats and records through the day before, the closing DraftKings spread, the official injury report from 90 minutes before the first game, and that week's NBA.com rankings. ESPN BPI has no history, so power rank uses our own net rating plus NBA.com.</div></div>`;
  }
  if(DATA.kind==='final' && DATA.earlier_label){
    h += `<div class="panel final"><h2>What changed since the ${esc(DATA.earlier_label)} board</h2>` +
      (DATA.changes && DATA.changes.length ? `<ul>${DATA.changes.map(c=>`<li>${esc(c)}</li>`).join('')}</ul>` : `<div style="color:#D3D9E5;font-size:14px">No changes.</div>`) + '</div>';
  }
  if(!DATA.games.length) h += '<div class="panel pad">No NBA games today.</div>';
  let i = 0;
  [['Qualified',q,'#2FC373','','Score 28+ or last-3 mismatch'],
   ['Watch list',w,'#E9B23A','#FFD66B','Score 18-27'],
   ['Did not qualify',n,'#E04848','#FF7676','']].forEach(([t,list,dot,col,sub])=>{
    if(!DATA.games.length) return;
    if(t==='Watch list' && !list.length) return;
    const red = t==='Did not qualify';
    h += `<section><div class="sec-head"><span style="width:10px;height:10px;border-radius:50%;background:${dot};box-shadow:0 0 10px ${dot}"></span>
      <h2 class="cond" style="color:${col||'#E6EAF2'}">${t}</h2><span class="cnt">${list.length}</span><div class="rule"></div><span style="font-size:12px;color:var(--dim)">${sub?esc(sub):'Sorted by hero score'}</span></div>
      ${red?'<div class="redline grow"></div>':''}${t==='Watch list'?'<div class="amberline grow"></div>':''}<div class="grid">${list.map(g=>card(g,i++)).join('') || '<div style="color:var(--muted);font-size:14px">None today.</div>'}</div></section>`;
  });
  h += `<p style="font-size:12px;color:var(--dim);line-height:1.6">Sources: team metrics computed from ESPN box scores · spreads via ESPN (${esc((DATA.games.find(g=>g.spread)||{spread:{}}).spread.provider||'sportsbook')}) · injuries: ${esc(DATA.injury_source||'unavailable')} · power: own net rating, ESPN BPI, NBA.com. Context only, not betting advice.</p>`;
  return h;
}

function heat(fav, dog){
  const head = [[fav.abbr,'Season'],[fav.abbr,'Last 3'],[dog.abbr,'Season'],[dog.abbr,'Last 3']];
  let h = `<div class="hm" style="align-items:end"><span></span>${head.map(x=>`<span style="text-align:center;font-size:11px;font-weight:700;color:#C7CEDC">${esc(x[0])}<br><span style="font-weight:500;color:#7C869E">${x[1]}</span></span>`).join('')}</div>`;
  ['efg','off','opp_efg','def'].forEach((m,ri)=>{
    h += `<div class="hm"><span style="font-size:12.5px;font-weight:600">${NAMES[m]}</span>` +
      [[fav,'season',1],[fav,'last3',1],[dog,'season',0],[dog,'last3',0]].map(([t,w,isF],ci)=>{
        const r = rk(t,w,m), v = (t[w]||{})[m];
        return `<span class="cell ${isF?favCls(r):dogCls(r)}" style="animation-delay:${250+ri*80+ci*40}ms"><b class="cond" style="font-size:17px;line-height:1">${fmt(m,v)}</b><span style="font-size:10.5px;font-weight:700;opacity:.85">#${r??'–'}</span></span>`;
      }).join('') + '</div>';
  });
  return h;
}

function butterfly(fav, dog){
  let h = `<div style="display:grid;grid-template-columns:minmax(0,1fr) 96px minmax(0,1fr);gap:4px 10px;margin-bottom:8px;font-size:12px;font-weight:700;color:#C7CEDC"><span style="text-align:right">${esc(fav.abbr)}</span><span></span><span>${esc(dog.abbr)}</span></div>`;
  COLS.forEach((c,i)=>{
    const fr = rk(fav,'last3',c.f), dr = rk(dog,'last3',c.d);
    const w = r => r==null?18:Math.max(18,(31-r)/30*100);
    h += `<div style="display:grid;grid-template-columns:minmax(0,1fr) 96px minmax(0,1fr);gap:10px;align-items:center;margin-bottom:12px">
      <div style="display:flex;justify-content:flex-end;height:26px;border-radius:8px;background:rgba(6,10,20,.45)"><span class="grow-r cond ${favCls(fr)}" style="width:${w(fr)}%;border-radius:8px;display:flex;align-items:center;padding-left:8px;font-weight:700;font-size:14px;animation-delay:${300+i*90}ms">#${fr??'–'}</span></div>
      <span style="text-align:center;font-size:11.5px;line-height:1.2;color:#C7CEDC"><b>${c.fly}</b><br><span style="color:#7C869E">${NAMES[c.f]} vs ${NAMES[c.d]}</span></span>
      <div style="display:flex;height:26px;border-radius:8px;background:rgba(6,10,20,.45)"><span class="grow cond ${dogCls(dr)}" style="width:${w(dr)}%;border-radius:8px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;font-weight:700;font-size:14px;animation-delay:${300+i*90}ms">#${dr??'–'}</span></div></div>`;
  });
  return h;
}

function trend(fav, dog, m, i){
  const day = d => Math.round(new Date(d+'T12:00:00Z').getTime()/864e5);
  const end = day(DATA.date) - 1;
  const games = t => (t.last3_games||[]).filter(x=>x.metrics && x.metrics[m]!=null).map(x=>({d:day(x.date), v:x.metrics[m]})).sort((a,b)=>a.d-b.d);
  const fg = games(fav), dg = games(dog), fs = (fav.season||{})[m], ds = (dog.season||{})[m];
  const start = Math.min(end-6, ...fg.map(x=>x.d), ...dg.map(x=>x.d));
  const vals = fg.concat(dg).map(x=>x.v).concat([fs,ds].filter(v=>v!=null));
  if(!vals.length) return '';
  let mn = Math.min(...vals), mx = Math.max(...vals); const pad = (mx-mn)*.15 || 1; mn -= pad; mx += pad;
  const lower = (m==='opp_efg'||m==='def');
  const W=300,H=150,pl=36,pr=10,pt=12,pb=14;
  const X = d => pl + (d-start)*(W-pl-pr)/Math.max(1,end-start);
  const Y = v => lower ? pt+(v-mn)/(mx-mn)*(H-pt-pb) : pt+(mx-v)/(mx-mn)*(H-pt-pb);
  const path = a => a.map((p,j)=>(j?'L':'M')+X(p.d).toFixed(1)+' '+Y(p.v).toFixed(1)).join(' ');
  const dots = (a,col) => a.map(p=>`<circle class="fade" cx="${X(p.d).toFixed(1)}" cy="${Y(p.v).toFixed(1)}" r="4.5" fill="${col}" stroke="#0F1626" stroke-width="2" style="animation-delay:${1100+i*120}ms"><title>${fmt(m,p.v)}</title></circle>`).join('');
  const hl = (v,col) => v==null?'':`<path d="M${pl} ${Y(v).toFixed(1)} L${W-pr} ${Y(v).toFixed(1)}" fill="none" stroke="${col}" stroke-width="1.3" stroke-dasharray="4 4" opacity=".5"/>`;
  const dir = a => a.length<2?'→ flat':(Math.abs(a[a.length-1].v-a[0].v)<(m.includes('efg')?1:2)?'→ flat':((a[a.length-1].v>a[0].v)!==lower?'↑ improving':'↓ slipping'));
  const ticks = []; for(let d=start; d<=end; d++){ const dt=new Date(d*864e5); ticks.push(`<text x="${X(d).toFixed(1)}" y="${H+6}" font-size="9.5" fill="#7C869E" text-anchor="middle" font-family="Inter,sans-serif">${['Su','Mo','Tu','We','Th','Fr','Sa'][dt.getUTCDay()]}</text>`); }
  const grid = [0,.5,1].map(f=>`M${pl} ${(pt+f*(H-pt-pb)).toFixed(1)} L${W-pr} ${(pt+f*(H-pt-pb)).toFixed(1)}`).join(' ');
  return `<div class="panel" style="padding:16px 16px 12px"><div class="row between"><b style="font-size:14px">${NAMES[m]}</b><span style="font-size:10.5px;color:var(--dim)">${lower?'↑ better (lower value)':'↑ better'}</span></div>
    <div class="row" style="gap:14px;font-size:11.5px;margin:6px 0 2px;color:#9AA4BA"><span><i class="sw" style="background:#60A5FA;border-radius:50%"></i> ${esc(fav.abbr)} ${dir(fg)}</span><span><i class="sw" style="background:#FB923C;border-radius:50%"></i> ${esc(dog.abbr)} ${dir(dg)}</span></div>
    <svg viewBox="0 0 ${W} ${H+12}" role="img" aria-label="${NAMES[m]} over the last 3 games" style="width:100%;height:auto;display:block;overflow:visible">
      <path d="${grid}" fill="none" stroke="#1F2A42"/>${hl(fs,'#60A5FA')}${hl(ds,'#FB923C')}
      <path class="draw" pathLength="1" d="${path(fg)}" fill="none" stroke="#60A5FA" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:1;animation-delay:${300+i*120}ms"/>
      <path class="draw" pathLength="1" d="${path(dg)}" fill="none" stroke="#FB923C" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:1;animation-delay:${300+i*120}ms"/>
      ${dots(fg,'#60A5FA')}${dots(dg,'#FB923C')}
      <text x="${pl-5}" y="${pt+3}" font-size="9.5" fill="#7C869E" text-anchor="end" font-family="Inter,sans-serif">${fmt(m,lower?mn:mx)}</text>
      <text x="${pl-5}" y="${H-pb+3}" font-size="9.5" fill="#7C869E" text-anchor="end" font-family="Inter,sans-serif">${fmt(m,lower?mx:mn)}</text>${ticks.join('')}</svg>
    <div style="margin-top:8px;font-size:10.5px;color:var(--dim)">Dashed = season average · dots = game days</div></div>`;
}

function detailView(g){
  const sc = g.scoring||{}, fav = favOf(g)||g.home, dog = dogOf(g)||g.away;
  const b = sc.scored ? BAND[sc.band] : {num:'#8B95AB',word:'No line'};
  let h = `<div class="row" style="flex-wrap:wrap;margin-bottom:18px"><button class="btn" onclick="location.hash=''"><svg viewBox="0 0 16 16" width="14" height="14" style="fill:none;stroke:currentColor;stroke-width:2" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>All games</button>
    <span style="font-size:13px;color:var(--muted)">${esc(g.tip_pt)} · Data pulled ${esc(DATA.built_label)}</span>
    ${sc.tracked && LIVE_ON?`<div class="tabs" style="margin-left:auto"><a class="on" aria-current="page" href="#g-${g.id}">Pregame</a><a href="${LIVE_URL}?g=${g.id}"><span class="lv-dot" data-livedot="${g.id}"></span>Live</a></div>`:''}</div>
    <h1 class="title cond" style="font-size:40px">${esc(g.away.name)} <span style="color:#7C869E">@</span> ${esc(g.home.name)}</h1>
    <div style="margin:8px 0 20px;font-size:14px;color:#9AA4BA">${g.spread?`Spread: ${esc(g.spread.details)} (${esc(g.spread.provider||'')})`:'No spread posted yet'}${g.neutral?' · Neutral site':''}${sc.scored?` · Favorite: ${esc(fav.name)}`:''}</div>`;
  const tier2 = sc.tier || (sc.qualified ? 'qualified' : 'out');
  if(sc.scored && tier2==='watch') h += `<div class="banner fade" style="align-items:center;background:linear-gradient(180deg,rgba(233,178,58,.18),rgba(217,161,42,.08));border:1px solid rgba(233,178,58,.5)"><span class="chip" style="color:#2A1C00;background:linear-gradient(180deg,#FADB80,#D9A12A);text-transform:uppercase">Watch list</span><span style="font-size:14px;color:#FDE68A">${esc(sc.fails[0])}. Tracked live.</span></div>`;
  if(sc.scored && tier2==='out') h += `<div class="banner fade" style="background:linear-gradient(180deg,rgba(212,68,68,.22),rgba(161,34,34,.16));border:1px solid rgba(220,60,60,.5)"><span class="chip" style="color:#fff;background:linear-gradient(180deg,#D44444,#A12222);text-transform:uppercase">No track</span><div style="display:flex;flex-direction:column;gap:4px;font-size:14px;color:#FECACA">${sc.fails.map(f=>`<span>${esc(f)}</span>`).join('')}</div></div>`;
  if(sc.qualified) h += `<div class="banner fade" style="align-items:center;background:linear-gradient(180deg,rgba(47,195,115,.16),rgba(31,157,88,.08));border:1px solid rgba(47,195,115,.45)"><span class="chip" style="background:linear-gradient(180deg,#34C77B,#1A8A4C);color:#fff;text-shadow:0 1px 1px rgba(0,0,0,.25);text-transform:uppercase">Track game</span><span style="font-size:14px;color:#BBF7D0">Qualified: ${esc(sc.route||sc.qualifiers.join(', '))}</span></div>`;
  if(sc.scored && sc.rules && sc.rules.length && sc.rules[0].rule==='A'){
    h += `<div class="panel pad" style="margin-bottom:14px"><h3 style="margin:0 0 8px">How it qualifies</h3><div style="display:flex;flex-direction:column;gap:6px;font-size:14px">${sc.rules.map(r=>`<div style="display:grid;grid-template-columns:22px minmax(0,1fr);gap:8px;align-items:start"><span style="width:20px;height:20px;border-radius:6px;display:grid;place-items:center;font-weight:800;font-size:12px;${r.pass?'background:linear-gradient(180deg,#34C77B,#1A8A4C);color:#fff;text-shadow:0 1px 1px rgba(0,0,0,.25)':'background:#3A1E22;color:#FCA5A5;border:1px solid rgba(200,48,48,.5)'}">${r.pass?'✓':'✗'}</span><span><b>${esc(r.rule==='Injury'?'Injury gate':(r.rule==='Power'?'Power gate':'Route '+r.rule))}: ${esc(r.name)}</b><br><span style="color:var(--muted);font-size:12.5px">${esc(r.detail)}</span></span></div>`).join('')}</div>
      <div style="font-size:12px;color:var(--dim);margin-top:8px">Qualified = route A or B, with both gates clear. Watch list = score 18-27 with both gates clear. Qualified and Watch list games are tracked live.</div></div>`;
  }
  (sc.warnings||[]).forEach(w=>{ h += /^Info:/.test(w)||/Neutral/.test(w) ? `<div style="font-size:13px;color:#9AA4BA;margin:0 0 10px 4px">${esc(w.replace(/^Info: /,''))}</div>` : `<div class="warn" style="margin-bottom:10px">${esc(w)}</div>`; });
  const people = t => (t.closers&&t.closers.length? 'Closers: '+t.closers.join(', ') : 'Top scorers: '+((t.top_scorers||[]).map(p=>`${p.name} ${p.ppg}`).join(', ')||'–'));
  h += `<div class="two" style="margin-top:10px"><div class="panel pad" style="flex:1 1 240px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px">${donut(sc,176,0)}<span style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:${b.num}">${b.word}</span></div>
    <div class="panel pad" style="flex:999 1 340px;min-width:0;display:flex;flex-direction:column;gap:12px"><div class="row"><h3 style="margin:0">Matchup summary</h3><span class="tag" style="color:#C4B5FD;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.4)">FROM THE NUMBERS</span></div>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#D3D9E5">${esc(g.summary)}</p>
