      <div class="fade" style="position:absolute;top:-5px;left:${sc.score/MAX*100}%;width:3px;height:16px;margin-left:-1.5px;border-radius:2px;background:#fff;box-shadow:0 0 6px rgba(255,255,255,.8);animation-delay:900ms"></div>
      <div style="position:relative;height:16px;margin-top:4px;font-size:10.5px;color:var(--dim)"><span style="position:absolute;left:0">0 · Risk</span><span style="position:absolute;left:${18/MAX*100}%">18 · Moderate</span><span style="position:absolute;left:${28/MAX*100}%">28 · Strong</span><span style="position:absolute;right:0">${MAX}</span></div></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px 20px;margin-top:16px">${sc.parts.map(p=>`<div class="row" style="gap:8px;font-size:13px;color:#C7CEDC"><i class="sw" style="background:${segCol[p.key]}"></i><span style="flex:1">${esc(p.label)}</span><b class="cond" style="font-size:15px">${p.points}<span style="color:#7C869E;font-weight:500"> / ${p.max}</span></b></div>`).join('')}</div></div>`;
    h += `<div class="cols2"><div class="panel pad"><h3>Metric heat map</h3><p class="note">Value and league rank. Underdog colors are flipped, so green is always good for the bet.</p>${heat(fav,dog)}</div>
      <div class="panel pad"><h3>Head-to-head, last 3</h3><p class="note">Longer bar = stronger rank. ${esc(fav.abbr)} extends left, ${esc(dog.abbr)} right.</p>${butterfly(fav,dog)}</div></div>`;
  }
  h += `<div class="cols2">${[fav,dog].map(t=>`<div class="panel pad"><div class="row between" style="margin-bottom:10px"><h3 style="margin:0">${esc(t.name)} · last 3 games</h3><span style="font-size:12px;font-weight:700;color:#C7CEDC">L3 ${formPill(t.l3_record, t.is_fav)}${t.b2b?' · B2B tonight':''}</span></div>
    <div class="tbl-row" style="border-top:0;font-size:11px;color:var(--dim);padding:0 0 6px"><span>Date</span><span>Opponent (power rank)</span><span>Score</span></div>
    ${(t.last3_games||[]).map((x,j)=>{const w=x.pts>x.opp_pts; const dt=new Date(x.date+'T12:00:00Z'); return `<div class="tbl-row fade" style="animation-delay:${250+j*90}ms"><span style="color:#9AA4BA">${dt.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',timeZone:'UTC'})}</span>
      <span><span style="color:#7C869E">${x.site==='home'?'vs':(x.site==='away'?'@':'vs')}</span> ${esc(x.opp)} <span style="color:#8B95AB">(#${x.opp_power_rank??'–'})</span></span>
      <span class="row" style="gap:8px"><span class="wl ${w?'pg':'pr'}">${w?'W':'L'}</span><b class="cond" style="font-size:16px;font-weight:600">${x.pts}-${x.opp_pts}</b></span></div>`;}).join('')}</div>`).join('')}</div>`;
  if(sc.scored) h += `<h2 class="sec-title cond">Last 3 trend</h2><div class="cols4">${['efg','off','opp_efg','def'].map((m,i)=>trend(fav,dog,m,i)).join('')}</div>`;
  const inj = t => (t.injuries||[]).length ? t.injuries.map(i=>`<div class="row" style="padding:8px 0;border-top:1px solid var(--line);font-size:13.5px"><b style="width:44px">${esc(t.abbr)}</b><span style="flex:1;color:#D3D9E5">${esc(i.player)}${i.is_key?' <span class="tag" style="color:#FDE68A;border:1px solid rgba(233,178,58,.5)">KEY</span>':''}<br><span style="font-size:11.5px;color:var(--dim)">${esc(i.reason||'')}</span></span><span class="chip ${i.counts_as_out?'pr':(i.status==='Questionable'?'py':'pn')}">${esc(i.status)}</span></div>`).join('') : `<div style="padding:8px 0;border-top:1px solid var(--line);font-size:13.5px;color:#9AA4BA"><b>${esc(t.abbr)}</b> · nobody listed</div>`;
  const pw = t => { const p=t.power||{}; return `<div style="display:grid;grid-template-columns:44px repeat(4,minmax(0,1fr));gap:6px;padding:7px 0;border-top:1px solid var(--line);font-size:13.5px"><b>${esc(t.abbr)}</b><span>#${p.own_net??'–'}</span><span>#${p.bpi??'–'}</span><span style="color:${p.split?'#FDBA74':'#D3D9E5'}">#${p.nba_com??'–'}</span><b>#${p.rank??'–'}</b></div>`; };
  h += `<div class="cols3"><div class="panel pad"><h3 style="margin-bottom:12px">Injury report</h3>${inj(fav)}${inj(dog)}<p style="margin:10px 0 0;font-size:11.5px;color:var(--dim)">KEY = started half the team's games or top 5 in minutes. Out/Doubtful count as out; Questionable is a warning.</p></div>
    <div class="panel pad"><h3 style="margin-bottom:12px">Power rank sources</h3><div style="display:grid;grid-template-columns:44px repeat(4,minmax(0,1fr));gap:6px;font-size:11px;color:var(--dim);margin-bottom:6px"><span></span><span>Own NR</span><span>BPI</span><span>NBA.com</span><span style="color:#C7CEDC;font-weight:700">Consensus</span></div>${pw(fav)}${pw(dog)}
      <p style="margin:10px 0 0;font-size:12px;line-height:1.5;color:#9AA4BA">NBA.com is weekly and counts half. Amber = it disagrees enough to move a team into or out of the top or bottom 10.</p></div>
    <div class="panel pad"><h3 style="margin-bottom:12px">Sources and timestamps</h3><div style="display:flex;flex-direction:column;gap:8px;font-size:13px;color:#C7CEDC;line-height:1.4">
      <span>Metrics: computed from ESPN box scores through ${esc(DATA.metrics_through||'–')}</span><span>Spread: ${esc(g.spread?g.spread.provider:'none')} via ESPN, pulled ${esc(DATA.built_label)}</span>
      <span>Injuries: ${esc(DATA.injury_source||'unavailable')}${DATA.injury_report_time?` (${esc(new Date(DATA.injury_report_time).toLocaleString('en-US',{timeZone:'America/Los_Angeles',hour:'numeric',minute:'2-digit',month:'short',day:'numeric'}))} PT)`:''}</span>
      <span>Power ranks: own net rating, ESPN BPI, NBA.com weekly</span></div></div></div>`;
  h += readoutPanel(g);
  return h;
}

// Analyst readout (Qualified + Watch list games): what published previews say. Information only.
function readoutPanel(g){
  const sc = g.scoring||{};
  if(!(sc.tracked ?? sc.qualified)) return '';
  const r = g.readout;
  if(!r) return `<div class="panel pad" style="margin-top:16px"><h3 style="margin:0 0 6px">Analyst readout</h3><div style="font-size:13.5px;color:var(--muted)">Not gathered yet. It's added each morning before the board.</div></div>`;
  const when = r.updated ? new Date(r.updated).toLocaleString('en-US',{timeZone:'America/Los_Angeles',hour:'numeric',minute:'2-digit',month:'short',day:'numeric'})+' PT' : '';
  const row = (k,v) => v ? `<div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:10px;padding:8px 0;border-top:1px solid var(--line);font-size:13.5px"><span style="color:var(--dim);font-weight:600">${k}</span><span style="color:#D3D9E5">${esc(v)}</span></div>` : '';
  const src = (r.sources||[]).filter(x=>x && x.url && /^https?:\/\//.test(x.url)).map(x=>`<a href="${esc(x.url)}" target="_blank" rel="noopener noreferrer">${esc(x.site||'source')}</a>`).join(' · ');
  return `<div class="panel pad" style="margin-top:16px"><div class="row between" style="margin-bottom:10px;gap:10px;flex-wrap:wrap"><h3 style="margin:0">Analyst readout</h3><span style="font-size:12px;color:var(--dim)">${esc(when)}</span></div>
    <p style="margin:0 0 6px;font-size:15px;line-height:1.55;color:#E6EAF2">${esc(r.summary)}</p>
    ${row('Pick',r.pick)}${row('Predicted score',r.predicted_score)}${row('Injuries',r.injuries)}
    ${src?`<div style="padding-top:8px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted)">Sources: ${src}</div>`:''}
    <div style="font-size:11.5px;color:var(--dim);margin-top:6px">From published previews; information only, never changes the tier or grade.</div></div>`;
}

function countUp(){
  if(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('[data-count]').forEach(el=>{
    const target = +el.dataset.count, delay = +el.dataset.delay||0, t0 = performance.now()+delay;
    el.textContent = '0';
    const step = now => { const p = Math.min(1, Math.max(0,(now-t0)/1200)); el.textContent = Math.round(target*(1-Math.pow(1-p,3))); if(p<1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  });
}

// ---- live status on today's board (tracked games only) ----
const LIVE_URL = '{{ pages_url }}live/';
const ET_TODAY = new Intl.DateTimeFormat('en-CA',{timeZone:'America/New_York'}).format(new Date());
const LIVE_ON = DATA.kind !== 'retro' && DATA.date === ET_TODAY;
const LIVE = {};
window.openGame = id => { const s = LIVE[id]; if(s && s.state !== 'pre') location.href = LIVE_URL + '?g=' + id; else location.hash = 'g-' + id; };
function paintLive(){
  document.querySelectorAll('[data-live]').forEach(el=>{
    const s = LIVE[el.dataset.live]; if(!s || s.state==='pre'){ el.innerHTML=''; return; }
    if(s.state==='post'){ el.innerHTML = `Final · ${esc(s.score)}`; return; }
    el.innerHTML = `<i></i>LIVE ${esc(s.clock)} · ${esc(s.lead)}${s.grade&&s.grade!=='–'?` <span class="g ${s.grade[0]==='A'?'':esc(s.grade)}">${esc(s.grade)}</span>`:''}`;
  });
  document.querySelectorAll('[data-livedot]').forEach(el=>{ const s = LIVE[el.dataset.livedot]; el.textContent = s && s.state==='in' ? ' ' : ''; });
}
async function pollLive(){
  if(!LIVE_ON) return;
  try{
    const ymd = DATA.date.replace(/-/g,'');
    const sb = await (await fetch(`https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard?dates=${ymd}&t=${Date.now()}`)).json();
    const tracked = new Set(DATA.games.filter(g=>g.scoring&&(g.scoring.tracked ?? g.scoring.qualified)).map(g=>g.id));
    let ctx = null;
    for(const e of (sb.events||[])){
      if(!tracked.has(e.id)) continue;
      const c = e.competitions[0], st = c.status, ab = x => c.competitors.find(t=>t.homeAway===x);
      const a = ab('away'), h = ab('home'), m = (+a.score||0) - (+h.score||0);
      const s = LIVE[e.id] = {state: st.type.state, clock: `Q${st.period>4?'OT':st.period} ${st.displayClock}`,
        score: `${a.team.abbreviation} ${a.score}-${h.score} ${h.team.abbreviation}`,
        lead: m===0?'Tied':`${m>0?a.team.abbreviation:h.team.abbreviation} +${Math.abs(m)}`, grade: (LIVE[e.id]||{}).grade};
      if(s.state==='in' && window.LiveEngine){
        try{
          ctx = ctx || await (await fetch(LIVE_URL + 'context.json?t=' + Date.now())).json();
          const summ = await (await fetch(`https://site.api.espn.com/apis/site/v2/sports/basketball/nba/summary?event=${e.id}`)).json();
          s.grade = LiveEngine.analyze(summ, {date: DATA.date, closers: (ctx||{}).closers||{}}).decision.grade;
        }catch(err){}
      }
    }
    paintLive();
    if(Object.values(LIVE).some(s=>s.state!=='post')) setTimeout(pollLive, 60000);
  }catch(err){ setTimeout(pollLive, 120000); }
}

function render(){
  const id = (location.hash||'').replace(/^#g-/,'');
  const g = DATA.games.find(x=>x.id===id);
  app.innerHTML = g ? detailView(g) : listView();
  paintLive();
  countUp();
  window.scrollTo(0,0);
}
window.addEventListener('hashchange', render);
render();
pollLive();
})();
</script>
</body>
</html>
