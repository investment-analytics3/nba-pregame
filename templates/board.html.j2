      <div class="row" style="flex-wrap:wrap;padding-top:10px;border-top:1px solid #222C44"><b style="font-size:14px">${esc(g.lean)}</b><span class="chip" style="color:#8B95AB;border:1px solid #2A3550;font-weight:600">Context only, not a bet</span></div></div></div>`;
  if(sc.scored){
    const segCol = {fav_metrics:'#3B82F6',dog_metrics:'#8B5CF6',net:'#22D3EE',form:'#2DD4BF',power:'#818CF8',home:'#38BDF8',health:'#C4B5FD',rest:'#A3E635'};
    h += `<div class="panel pad" style="margin-bottom:20px"><div class="row between" style="margin-bottom:14px"><h3 style="margin:0">Score breakdown</h3><span style="font-size:13px;color:#9AA4BA"><b style="color:${b.num};font-size:15px">${sc.score}</b> of ${MAX}</span></div>
      <div style="display:flex;height:22px;border-radius:999px;overflow:hidden;background:#141B2C;box-shadow:inset 0 2px 4px rgba(0,0,0,.6)">${sc.parts.map((p,i)=>`<span class="grow" title="${esc(p.label)}: ${p.points} of ${p.max}" style="width:${(p.points/MAX*100).toFixed(2)}%;background:${segCol[p.key]};box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset -1px 0 0 rgba(0,0,0,.35);animation-delay:${200+i*90}ms"></span>`).join('')}</div>
