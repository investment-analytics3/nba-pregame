<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NBA Board Results</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap">
<style>
:root{--bg:#0A0F1C;--line:#1F2A42;--text:#E6EAF2;--muted:#8B95AB;--dim:#7C869E;--head:#151C2E}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}
a{color:#93C5FD}
.wrap{max-width:1500px;margin:0 auto;padding:16px 16px 72px}
.cond{font-family:'Barlow Condensed',Inter,sans-serif}
.nav{display:flex;gap:6px;margin-bottom:20px;border-bottom:1px solid var(--line);padding-bottom:10px}
.nav a{padding:8px 14px;border-radius:999px;font-size:14px;font-weight:600;color:#C7CEDC;text-decoration:none}
.nav a.on{background:#1C2640;color:#fff;border:1px solid #2E3B5C}
h1{margin:4px 0 0;font-size:42px;line-height:1;font-weight:700}
.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:600}
.panel{border-radius:18px;border:1px solid var(--line);background:linear-gradient(180deg,#172036,#111829);box-shadow:0 12px 30px rgba(0,0,0,.4)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px;margin:20px 0 6px}
.card{padding:16px 20px}
.card h2{margin:0 0 10px;font-size:20px;letter-spacing:.04em;text-transform:uppercase}
.stat{display:flex;justify-content:space-between;align-items:baseline;padding:6px 0;border-top:1px solid var(--line);font-size:14px;color:#C7CEDC}
.stat b{font-size:22px;color:#fff}.stat .p{font-size:13px;color:var(--muted);margin-left:6px}
.filtnote{font-size:12.5px;color:#FDE68A;min-height:18px;margin:6px 2px 10px}
.bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:4px 0 12px;font-size:13px;color:#C7CEDC}
.seg{display:inline-flex;border:1px solid #26314B;border-radius:999px;overflow:hidden}
.seg button,.btn{all:unset;cursor:pointer;padding:7px 13px;font-size:13px;font-weight:600;color:#DCE2EE;background:#151C2E}
.seg button.on{background:#2F6FE0;color:#fff}
.btn{border:1px solid #26314B;border-radius:999px}
.scroll{overflow:auto;max-height:78vh;border-radius:16px;border:1px solid var(--line)}
table{border-collapse:separate;border-spacing:0;width:100%;min-width:1680px;font-size:13px}
thead th{position:sticky;background:var(--head);z-index:2;text-align:center;border-right:1px solid rgba(255,255,255,.2);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#9AA4BA;padding:8px 8px;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,.35)}
thead tr.g th{top:0;height:30px;text-align:center;color:#C7CEDC}
thead tr.n th{top:30px;cursor:pointer;user-select:none;height:34px}
thead tr.n th:hover{color:#fff}
thead tr.f th{top:64px;padding:6px 6px 8px;cursor:default}
select,input[type=text]{width:100%;min-width:62px;background:#0E1424;color:#DCE2EE;border:1px solid #2A3550;border-radius:8px;padding:5px 6px;font:inherit;font-size:12px}
select.active,input.active{border-color:#E9B23A;background:#2A2410}
td{padding:7px 8px;white-space:nowrap;vertical-align:middle;text-align:center;border-bottom:1px solid rgba(255,255,255,.16);border-right:1px solid rgba(255,255,255,.2)}
td.stick2{text-align:left}
td[rowspan]{border-bottom:2px solid rgba(255,255,255,.65)}
tr.fav td{background:#111a2c}
tr.opp td{background:#0d1424;border-bottom:2px solid rgba(255,255,255,.65)}
.stick1{position:sticky;left:0;z-index:1;width:96px;min-width:96px;max-width:96px;white-space:normal}.stick2{position:sticky;left:96px;z-index:1}
thead .stick1,thead .stick2{z-index:3}
td.stick2,thead th.stick2{border-right:2px solid rgba(255,255,255,.45)}
.role{font-size:10.5px;color:var(--dim);margin-left:5px}
.chip{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11.5px;font-weight:700}
.yes{background:rgba(47,195,115,.18);color:#86EFAC;border:1px solid rgba(47,195,115,.45)}
.no{background:rgba(220,50,50,.16);color:#FCA5A5;border:1px solid rgba(220,50,50,.45)}
.push{background:rgba(233,178,58,.16);color:#FDE68A;border:1px solid rgba(233,178,58,.45)}
.m{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;min-width:62px;padding:3px 6px;border-radius:8px;line-height:1.1}
.m b{font-size:13px}.m span{font-size:10px;opacity:.85;font-weight:700}
.green{background:linear-gradient(180deg,#43DE8F,#1F9D58);color:#03240F}
.yellow{background:linear-gradient(180deg,#FADB80,#D9A12A);color:#2A1C00}
.red{background:linear-gradient(180deg,#D44444,#A12222);color:#fff}
.deep-red{background:linear-gradient(180deg,#A31818,#650909);color:#fff;box-shadow:0 0 8px rgba(255,60,60,.5)}
.none{background:#1C2438;color:var(--dim)}
.score{display:inline-block;min-width:36px;text-align:center;padding:3px 7px;border-radius:8px;font-weight:700;font-size:14px}
.empty{padding:28px;text-align:center;color:var(--muted)}
</style>
</head>
<body>
<div class="wrap">
<nav class="nav"><a href="{{ pages_url }}">Home</a><a href="{{ pages_url }}nba/">Today's board</a><a class="on" href="{{ pages_url }}results.html">Results</a><a href="{{ pages_url }}live/">Live</a></nav>
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px">
  <div><div class="eyebrow">NBA · Running record</div><h1 class="cond">Results</h1></div>
  <div style="font-size:13px;color:var(--muted);text-align:right;line-height:1.6">Updated {{ d.updated }}<br><a href="{{ pages_url }}results.csv" download>Download spreadsheet (CSV)</a></div>
</div>
<div class="cards" id="cards"></div>
<div class="filtnote" id="filtnote"></div>
<div class="bar"><span>Team and metric filters and sorting use the</span>
  <span class="seg" id="roleSeg"><button type="button" data-role="Favorite">Favorite</button><button type="button" data-role="Opponent">Opponent</button></span>
  <span>row</span><button type="button" class="btn" id="reset">Clear filters</button></div>
<div class="scroll"><table><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
<p style="font-size:12px;color:var(--dim);line-height:1.6;margin-top:14px">Each game is graded from the last board sent before tip (the Final when there was one); record, last 3, B2B, power rank (PR) and metrics are as they stood on that board.
Rows tagged "rebuilt" come from days rebuilt after the fact using only what was known before tip-off (closing spread, that day's injury report; power rank without ESPN BPI).
Favorite row colors: green = top 10, yellow = 11-20, red = 21-30. Opponent row colors are flipped (red = a strong opponent). Covered = the favorite won by more than the spread.
Click a team to open that day's board for the game. Click a column title to sort.</p>
</div>
<script>const DATA = {{ data_json|safe }};</script>
<script>
(function(){
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const BASE = {{ pages_url|tojson }};
const MET = ['efg','off','opp_efg','def'], LBL = {efg:'eFG%',off:'Off Eff',opp_efg:'Opp eFG%',def:'Def Eff'};
const MCOLS = [].concat(...['season','last3'].map(w => MET.map(m => ({key:w+':'+m, w, m}))));
const favColor = r => r==null?'none':(r<=10?'green':(r<=20?'yellow':'red'));
const oppColor = r => r==null?'none':(r<=5?'deep-red':(r<=10?'red':(r<=20?'yellow':'green')));
const simple = c => c==='deep-red' ? 'red' : c;
const tinfo = (g, role) => (role==='Favorite' ? g.fav_team : g.opp_team) || {};
const winPct = rec => { const p = String(rec||'').split('-').map(Number); return (p.length===2 && p[0]+p[1]) ? p[0]/(p[0]+p[1]) : null; };
const cell = (g, role, w, m) => ((((role==='Favorite'?g.fav_metrics:g.opp_metrics)||{})[w]||{})[m]) || {};
const color = (g, role, w, m) => { const r = cell(g,role,w,m).r; return role==='Favorite' ? favColor(r) : oppColor(r); };
const fmt = (m, v) => v==null ? '–' : (m.includes('efg') ? (+v).toFixed(1)+'%' : (+v).toFixed(1));
const dateLabel = d => new Date(d+'T12:00:00Z').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',timeZone:'UTC'});

let st = {role:'Favorite', f:{}, sortKey:'date', asc:false};
try { const s = JSON.parse(localStorage.getItem('nba-results-state')||'null'); if (s) st = Object.assign(st, s); } catch (e) {}
const persist = () => { try { localStorage.setItem('nba-results-state', JSON.stringify(st)); } catch (e) {} };

const dates = [...new Set(DATA.games.map(g=>g.date))];
const COLS = [
  {k:'date', label:'Date', cls:'stick1', filter:['select', [['','All'],['7','Last 7 days'],['30','Last 30 days'],['sent','Sent boards'],['rebuilt','Rebuilt days']].concat(dates.map(d=>[d, dateLabel(d)]))]},
  {k:'team', label:'Team', cls:'stick2', filter:['text','Any team']},
  {k:'record', label:'Record', team:true, filter:['select',[['','All'],['w','Winning'],['e','.500'],['l','Losing']]]},
  {k:'l3', label:'Last 3', team:true, filter:['select',[['','All'],['3-0','3-0'],['2-1','2-1'],['1-2','1-2'],['0-3','0-3']]]},
  {k:'b2b', label:'B2B', team:true, filter:['select',[['','All'],['Yes','Yes'],['No','No']]]},
  {k:'pr', label:'PR', team:true, filter:['select',[['','All'],['t','Top 10'],['m','11-20'],['b','21-30']]]},
  {k:'spread', label:'Spread', filter:['select',[['','All'],['s','Under 4'],['m','4 to 7.5'],['l','8 or more']]]},
  {k:'score', label:'Score (fav-opp)'},
  {k:'winner', label:'Winner', filter:['select',[['','All'],['Yes','Favorite'],['No','Opponent']]]},
  {k:'covered', label:'Spread covered', filter:['select',[['','All'],['Yes','Yes'],['No','No'],['Push','Push']]]},
  {k:'above_line', label:'Above the line', filter:['select',[['','All'],['Yes','Yes'],['No','No']]]},
  {k:'analysis', label:'Analysis Score', filter:['select',[['','All'],['green','Green'],['yellow','Yellow'],['red','Red']]]},
].concat(MCOLS.map(c => ({k:c.key, label:LBL[c.m], metric:c, filter:['select',[['','All'],['green','Green'],['yellow','Yellow'],['red','Red']]]})));

function passes(g){
  const f = st.f, today = Date.now();
  if (f.date==='sent' && g.source==='Rebuilt') return false;
  if (f.date==='rebuilt' && g.source!=='Rebuilt') return false;
  if (f.date && f.date!=='sent' && f.date!=='rebuilt') { if (f.date==='7'||f.date==='30') { if ((today - new Date(g.date+'T12:00:00Z'))/864e5 > +f.date) return false; } else if (g.date!==f.date) return false; }
  if (f.team) { const q = f.team.trim().toUpperCase(); if (q && !(g.favorite.includes(q) || g.opponent.includes(q))) return false; }
  if (f.spread) { const s = +g.spread_num||0; if (f.spread==='s' && !(s<4)) return false; if (f.spread==='m' && !(s>=4 && s<=7.5)) return false; if (f.spread==='l' && !(s>=8)) return false; }
  const ti = tinfo(g, st.role);
  if (f.record) { const p = winPct(ti.record); if (p==null) return false; if (f.record==='w' && !(p>.5)) return false; if (f.record==='e' && p!==.5) return false; if (f.record==='l' && !(p<.5)) return false; }
  if (f.l3 && ti.l3!==f.l3) return false;
  if (f.b2b && (ti.b2b?'Yes':'No')!==f.b2b) return false;
  if (f.pr) { const r = ti.pr; if (r==null) return false; if (f.pr==='t' && r>10) return false; if (f.pr==='m' && (r<11||r>20)) return false; if (f.pr==='b' && r<21) return false; }
  if (f.winner && g.fav_won!==f.winner) return false;
  if (f.covered && g.covered!==f.covered) return false;
  if (f.above_line && g.above_line!==f.above_line) return false;
  if (f.analysis && g.band!==f.analysis) return false;
  for (const c of MCOLS) { const v = f[c.key]; if (v && simple(color(g, st.role, c.w, c.m))!==v) return false; }
  return true;
}
function sortVal(g){
  const k = st.sortKey;
  if (k==='date') return g.date + (g.tip_utc||'');
  if (k==='team') return g.favorite;
  if (k==='record') { const p = winPct(tinfo(g, st.role).record); return p==null ? -1 : p; }
  if (k==='l3') return +(String(tinfo(g, st.role).l3||'0').split('-')[0]);
  if (k==='b2b') return tinfo(g, st.role).b2b ? 1 : 0;
  if (k==='pr') { const r = tinfo(g, st.role).pr; return r==null ? 99 : r; }
  if (k==='spread') return +g.spread_num||0;
  if (k==='score') return g.fav_pts - g.opp_pts;
  if (k==='winner') return g.fav_won; if (k==='covered') return g.covered; if (k==='above_line') return g.above_line;
  if (k==='analysis') return g.analysis_score==null ? -1 : +g.analysis_score;
  const c = MCOLS.find(x=>x.key===k); if (c) { const r = cell(g, st.role, c.w, c.m).r; return r==null ? 99 : r; }
  return '';
}
function cards(games){
  const blk = gs => { const n=gs.length, w=gs.filter(g=>g.fav_won==='Yes').length, cov=gs.filter(g=>g.covered==='Yes').length,
    push=gs.filter(g=>g.covered==='Push').length, ats=gs.filter(g=>g.covered==='Yes'||g.covered==='No').length;
    return {n, w, l:n-w, wp:n?Math.round(100*w/n)+'%':'–', cov, nc:ats-cov, push, cp:ats?Math.round(100*cov/ats)+'%':'–'}; };
  const card = (t, b, col) => `<div class="panel card"><h2 class="cond" style="color:${col}">${t}</h2>
    <div class="stat">Games<b>${b.n}</b></div><div class="stat">Favorite won<span><b>${b.w}-${b.l}</b><span class="p">${b.wp}</span></span></div>
    <div class="stat">Covered the spread<span><b>${b.cov}-${b.nc}${b.push?'-'+b.push:''}</b><span class="p">${b.cp}</span></span></div></div>`;
  document.getElementById('cards').innerHTML = card('Above the line', blk(games.filter(g=>g.above_line==='Yes')), '#2FC373') +
    card('Below the line', blk(games.filter(g=>g.above_line==='No')), '#FF7676') + card('All shown', blk(games), '#C7CEDC');
}
function head(){
  const g = `<tr class="g"><th class="stick1"></th><th class="stick2"></th><th colspan="4" style="border-left:2px solid rgba(255,255,255,.45)">Team going in</th><th colspan="6" style="border-left:2px solid rgba(255,255,255,.45)">Game</th><th colspan="4" style="border-left:2px solid rgba(255,255,255,.45)">Season</th><th colspan="4" style="border-left:2px solid rgba(255,255,255,.45)">Last 3 games</th></tr>`;
  const n = '<tr class="n">' + COLS.map((c,i)=>`<th class="${c.cls||''}" data-k="${c.k}" style="${[2,6,12,16].includes(i)?'border-left:2px solid rgba(255,255,255,.45)':''}">${esc(c.label)}${st.sortKey===c.k?(st.asc?' ▲':' ▼'):''}</th>`).join('') + '</tr>';
  const f = '<tr class="f">' + COLS.map((c,i)=>{
    const v = st.f[c.k]||'', act = v ? 'active' : '', bl = [2,6,12,16].includes(i) ? 'border-left:2px solid rgba(255,255,255,.45)' : '';
    if (!c.filter) return `<th class="${c.cls||''}" style="${bl}"></th>`;
    if (c.filter[0]==='text') return `<th class="${c.cls||''}"><input type="text" class="${act}" data-fk="${c.k}" placeholder="${c.filter[1]}" value="${esc(v)}" aria-label="Filter ${esc(c.label)}"></th>`;
    return `<th class="${c.cls||''}" style="${bl}"><select class="${act}" data-fk="${c.k}" aria-label="Filter ${esc(c.label)}">${c.filter[1].map(([val,l])=>`<option value="${esc(val)}"${val===v?' selected':''}>${esc(l)}</option>`).join('')}</select></th>`;
  }).join('') + '</tr>';
  document.getElementById('thead').innerHTML = g + n + f;
  document.querySelectorAll('tr.n th[data-k]').forEach(th => th.onclick = () => {
    const k = th.dataset.k; st.asc = st.sortKey===k ? !st.asc : !(k==='date'||k==='analysis'||k==='score'); st.sortKey = k; persist(); draw();
  });
  document.querySelectorAll('[data-fk]').forEach(el => { const ev = el.tagName==='INPUT' ? 'input' : 'change';
    el.addEventListener(ev, () => { st.f[el.dataset.fk] = el.value; persist(); draw(el.tagName==='INPUT' ? el.dataset.fk : null); }); });
}
const link = (g, html) => g.board_page ? `<a href="${esc(BASE + g.board_page)}">${html}</a>` : html;
const chip = v => v ? `<span class="chip ${v==='Yes'?'yes':(v==='No'?'no':'push')}">${esc(v)}</span>` : '–';
function rows(games){
  if (!games.length) return `<tr><td colspan="${COLS.length}" class="empty">${DATA.games.length ? 'No games match these filters.' : 'No graded games yet. Results are added each morning at 3 AM for the previous day\'s boards.'}</td></tr>`;
  return games.map(g => {
    const metrics = role => MCOLS.map((c,i) => { const x = cell(g, role, c.w, c.m), col = role==='Favorite' ? favColor(x.r) : oppColor(x.r);
      return `<td style="${i===0||i===4?'border-left:2px solid rgba(255,255,255,.45)':''}"><span class="m ${col}" title="${role} ${c.w==='season'?'season':'last 3'} ${LBL[c.m]}: rank ${x.r??'n/a'}"><b>${fmt(c.m, x.v)}</b><span>#${x.r??'–'}</span></span></td>`; }).join('');
    const site = g.fav_site==='home' ? 'home' : (g.fav_site==='away' ? 'away' : 'neutral');
    const info = role => { const t = tinfo(g, role);
      return `<td style="border-left:2px solid rgba(255,255,255,.45)">${esc(t.record||'–')}</td><td>${esc(t.l3||'–')}</td>
        <td>${t.b2b ? '<span class="chip" style="background:linear-gradient(180deg,#9B5CF0,#6D28D9);color:#F5EBFF">Yes</span>' : '<span style="color:var(--dim)">No</span>'}</td>
        <td>${t.pr!=null ? '#'+t.pr : '–'}${t.pr_split ? ' <span class="chip" style="background:rgba(251,146,60,.16);color:#FDBA74;border:1px solid rgba(251,146,60,.45);padding:1px 6px" title="Power-rank sources disagree across the top/bottom-10 line">split</span>' : ''}</td>`; };
    const tag = g.source==='Rebuilt' ? '<br><span class="chip" style="margin-top:3px;background:rgba(233,178,58,.14);color:#FDE68A;border:1px solid rgba(233,178,58,.4);padding:1px 6px;font-size:10px" title="Board rebuilt after the fact from what was known before tip-off">rebuilt</span>' : '';
    return `<tr class="fav"><td class="stick1" rowspan="2">${link(g, esc(dateLabel(g.date)))}${tag}</td>
        <td class="stick2"><b>${link(g, esc(g.favorite))}</b><span class="role">Favorite · ${site}</span></td>${info('Favorite')}
        <td rowspan="2" style="border-left:2px solid rgba(255,255,255,.45)">${esc(g.spread)}</td><td rowspan="2">${g.fav_pts}-${g.opp_pts}</td><td rowspan="2">${esc(g.winner)}</td>
        <td rowspan="2">${chip(g.covered)}</td><td rowspan="2">${chip(g.above_line)}</td>
        <td rowspan="2">${g.analysis_score!=null ? `<span class="score ${esc(g.band)}">${g.analysis_score}</span>` : '–'}</td>${metrics('Favorite')}</tr>
      <tr class="opp"><td class="stick2">${link(g, esc(g.opponent))}<span class="role">Opponent</span></td>${info('Opponent')}${metrics('Opponent')}</tr>`;
  }).join('');
}
function draw(keepFocus){
  document.querySelectorAll('#roleSeg button').forEach(b => { b.classList.toggle('on', b.dataset.role===st.role); b.onclick = () => { st.role = b.dataset.role; persist(); draw(); }; });
  const games = DATA.games.filter(passes);
  games.sort((a,b) => { const x = sortVal(a), y = sortVal(b); return (x>y?1:x<y?-1:0) * (st.asc?1:-1); });
  cards(games);
  const active = Object.values(st.f).filter(Boolean).length;
  document.getElementById('filtnote').textContent = active ? `${active} filter${active>1?'s':''} on · showing ${games.length} of ${DATA.games.length} games` : '';
  if (!keepFocus) head();
  document.getElementById('tbody').innerHTML = rows(games);
  if (keepFocus) document.querySelectorAll('[data-fk]').forEach(el => el.classList.toggle('active', !!st.f[el.dataset.fk]));
}
document.getElementById('reset').onclick = () => { st.f = {}; persist(); draw(); };
draw();
})();
</script>
</body>
</html>
